{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AllowQuickSightAccess",
      "Effect": "Allow",
      "Principal": {
        "AWS": "arn:aws:iam::535362115856:role/service-role/aws-quicksight-service-role-v0"
      },
      "Action": [
        "s3:GetObject",
        "s3:ListBucket"
      ],
      "Resource": [
        "arn:aws:s3:::<BUCKET_NAME>",
        "arn:aws:s3:::<BUCKET_NAME>/*"
      ]
    },
    {
      "Sid": "AllowGlueAccess",
      "Effect": "Allow",
      "Principal": {
        "AWS": "arn:aws:iam::535362115856:role/service-role/AWSGlueServiceRole-pgx-data-model"
      },
      "Action": [
        "s3:GetObject",
        "s3:PutObject",
        "s3:DeleteObject",
        "s3:ListBucket"
      ],
      "Resource": [
        "arn:aws:s3:::<BUCKET_NAME>",
        "arn:aws:s3:::<BUCKET_NAME>/*"
      ]
    }
  ]
}
