{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Effect": "Allow",
      "Principal": {
        "Service": "quicksight.amazonaws.com"
      },
      "Action": "sts:AssumeRole",
      "Condition": {
        "StringEquals": {
          "aws:SourceAccount": "535362115856"
        },
        "ArnLike": {
          "aws:SourceArn": "arn:aws:quicksight:us-east-1:535362115856:*/datasource/*"
        }
      }
    }
  ]
}
